{
  "name": "farnel",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Household lunch planner: a web app and an MCP server for planning with Claude.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "pnpm types && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "pnpm types && tsc -b --noEmit",
    "test": "pnpm types && vitest run",
    "test:watch": "vitest",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.34.0",
    "jose": "^6.2.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "4.166.0"
  }
}
