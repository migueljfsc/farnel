{
  // Deployed by .github/workflows/deploy-worker.yml on push to main. Locally: pnpm build && pnpm deploy:worker --dry-run
  //
  // Static assets are served without invoking the script; only the paths in run_worker_first
  // run it, so page loads stay outside the free tier's request budget.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "farnel",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },

  "routes": [{ "pattern": "farnel.migueljfsc.dev", "custom_domain": true }],
  "workers_dev": false,

  // wrangler dev otherwise presents requests as the route's host; DEV_ACCESS_EMAIL needs localhost.
  "dev": { "host": "localhost" },

  // Access values come from `tofu output` after the first apply. AUD tags and the team domain
  // are identifiers, not secrets.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://migueljfsc.cloudflareaccess.com",
    "ACCESS_AUD_WEB": "901fba06d05511a3696197a78bcbb9a406054643f61c38e5df9dd352fc93e8ff",
    "ACCESS_AUD_MCP": "2504e3f083357b009a6d879a53f9b5536048b59de5ee79e4600f69690a84fdab"
  },

  // database_id comes from `tofu output d1_database_id` after the first apply.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "farnel-prod",
      "database_id": "ca1ba106-1aa2-44da-9873-4f0f41b9d25b",
      "migrations_dir": "./worker/migrations"
    }
  ],

  // Daily store price refresh (worker/index.ts `scheduled`).
  "triggers": { "crons": ["0 4 * * *"] },

  "observability": { "enabled": true }
}
